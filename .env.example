# Kopyala: cp .env.example .env; örnek parolaları yerelde değiştir.
# Ayrı demo projesi/volume; mevcut kullanıcı projesini veya volume'unu silmeyin.
COMPOSE_PROJECT_NAME=byteme-avatar-demo
MYSQL_DATABASE=avatar_demo_test
MYSQL_USER=avatar
MYSQL_PASSWORD=change-me-local-only
MYSQL_ROOT_PASSWORD=change-root-local-only
AVATAR_API_KEY=change-api-key-local-only
MYSQL_PUBLISHED_PORT=3306
# Host üzerinden backend çalıştırırken localhost; Compose backend için mysql override edilir.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
CORS_ORIGINS=http://127.0.0.1:5173
